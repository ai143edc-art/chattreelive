# Copy this file to `.env` (or `.env.local`) and fill in your Supabase project values.
# Both are required — the app will refuse to start without them.
#
# Find these in your Supabase dashboard:
#   Project Settings → API → Project URL
#   Project Settings → API → Project API keys → "anon" / "public"
#
# The anon key is safe to expose in the browser: all access is enforced by
# Row Level Security on the database. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL — Cloudflare Turnstile CAPTCHA (blocks bots on sign up / log in).
# Leave blank to disable; when set, you must ALSO enable Turnstile in
# Supabase → Authentication → Attack Protection and paste the SECRET key there.
# Get your keys at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# OPTIONAL — privacy-friendly analytics (Plausible, cookieless, no personal data).
# Leave blank for zero tracking. Set to your site's domain to enable, e.g.
#   VITE_PLAUSIBLE_DOMAIN=chat-tree-delta.vercel.app
# To self-host, also set VITE_PLAUSIBLE_SRC and allow the host in your CSP.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# OPTIONAL — translation tuning.
# A contact email raises MyMemory's free anonymous quota (~5k → ~50k words/day).
# Defaults to the app's public contact email if left blank.
VITE_MYMEMORY_EMAIL=
# Set to 1 ONLY after deploying the Gemini edge function (supabase/functions/translate)
# and setting GEMINI_API_KEY — then chat translation routes through it first.
VITE_USE_EDGE_TRANSLATE=
