// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MessageList DOM output (golden) > call rows and system message 1`] = `"<div class="day">1 June 2026</div><div class="sys">Messages are end-to-end encrypted</div><div class="row out" data-mi="1"><div class="bubble call"><span class="call-row"><span class="call-ic">📞</span><span class="call-txt"><span class="call-title">Voice call</span><span class="call-sub">3:12</span></span></span><span class="meta2">09:00 <span class="tick">✓✓</span></span></div></div><div class="row in" data-mi="2"><div class="bubble call"><span class="call-row"><span class="call-ic missed">📹</span><span class="call-txt"><span class="call-title">Missed video call</span><span class="call-sub">Tap to call back</span></span></span><span class="meta2">09:00 </span></div></div>"`;

exports[`MessageList DOM output (golden) > edit mode: tools, editable text, clickable ticks 1`] = `"<div class="day editable-day" title="Tap to change this date">1 June 2026</div><div class="row out editmode" data-mi="0"><span class="msg-tools"><button class="mt-btn" title="Reply">↩</button><span class="mt-react"><button class="mt-btn" title="React">😊</button></span><button class="mt-btn" title="Toggle Forwarded">↪</button><button class="mt-btn mt-del" title="Delete">🗑</button></span><div class="bubble editing"><span class="txt editable-live" contentEditable="true"></span><span class="meta2"><span class="time-edit" title="Tap to change time">09:00</span> <span class="tick tick-edit" title="Tap to change ticks">✓✓</span></span></div></div><div class="row in editmode" data-mi="1"><span class="msg-tools"><button class="mt-btn" title="Reply">↩</button><span class="mt-react"><button class="mt-btn" title="React">😊</button></span><button class="mt-btn" title="Toggle Forwarded">↪</button><button class="mt-btn mt-del" title="Delete">🗑</button></span><div class="bubble media"><img src="blob:pic" loading="lazy" alt=""/><span class="meta2"><span class="time-edit" title="Tap to change time">09:00</span> </span></div><span class="fwd" title="Forward"><svg viewBox="0 0 24 24"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"></path></svg></span></div>"`;

exports[`MessageList DOM output (golden) > emoji-only and placeholder 1`] = `"<div class="day">1 June 2026</div><div class="row out" data-mi="0"><div class="bubble emoji"><span class="txt">🔥</span><span class="meta2">09:00 <span class="tick">✓✓</span></span></div></div><div class="row in" data-mi="1"><div class="bubble"><span class="mediaph">📎 Media</span><span class="meta2">09:00 </span></div></div>"`;

exports[`MessageList DOM output (golden) > filter hides the middle message 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><div class="bubble"><span class="txt">one</span><span class="meta2">09:00 </span></div></div><div class="row in grp" data-mi="2"><div class="bubble"><span class="txt">three</span><span class="meta2">09:00 </span></div></div>"`;

exports[`MessageList DOM output (golden) > group chat with sender colours 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><span class="grp-ava" style="background:#8a6d00">R</span><div class="bubble"><div class="who c7">Riya</div><span class="txt">hi all</span><span class="meta2">09:00 </span></div></div><div class="row in" data-mi="1"><span class="grp-ava" style="background:#1f7aec">S</span><div class="bubble"><div class="who c1">Sana</div><span class="txt">hello</span><span class="meta2">09:00 </span></div></div><div class="row out" data-mi="2"><div class="bubble"><span class="txt">yo</span><span class="meta2">09:00 <span class="tick gray">✓</span></span></div></div>"`;

exports[`MessageList DOM output (golden) > media: image, video, doc, and missing 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><div class="bubble media"><img src="blob:pic" loading="lazy" alt=""/><span class="meta2">09:00 </span></div><span class="fwd" title="Forward"><svg viewBox="0 0 24 24"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"></path></svg></span></div><div class="row in grp" data-mi="1"><div class="bubble media"><video src="blob:clip" controls="" preload="metadata"></video><span class="meta2">09:00 </span></div><span class="fwd" title="Forward"><svg viewBox="0 0 24 24"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"></path></svg></span></div><div class="row in grp" data-mi="2"><div class="bubble"><a class="doc" href="blob:doc" download="doc.pdf" target="_blank" rel="noopener"><span class="ic">📕</span><span class="dn">doc.pdf</span></a><span class="meta2">09:00 </span></div><span class="fwd" title="Forward"><svg viewBox="0 0 24 24"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"></path></svg></span></div><div class="row in grp" data-mi="3"><div class="bubble"><span class="mediaph">📷 Photo</span><span class="meta2">09:00 </span></div></div><div class="row in grp" data-mi="4"><div class="bubble"><img src="blob:pic" loading="lazy" alt=""/><span class="txt">with a caption</span><span class="meta2">09:00 </span></div><span class="fwd" title="Forward"><svg viewBox="0 0 24 24"><path d="M14 9V5l7 7-7 7v-4.1c-5 0-8.5 1.6-11 5.1 1-5 4-10 11-11z"></path></svg></span></div>"`;

exports[`MessageList DOM output (golden) > reply, reactions, forwarded 1`] = `"<div class="day">1 June 2026</div><div class="row out" data-mi="0"><div class="bubble"><div class="fwd-label">↪ Forwarded</div><span class="txt">see this</span><span class="meta2">09:00 <span class="tick">✓✓</span></span></div></div><div class="row in" data-mi="1"><div class="bubble has-react"><div class="reply-quote"><div class="rq-name">Vikku</div><div class="rq-text">see this</div></div><span class="txt">nice</span><span class="reactions">❤️ 😂</span><span class="meta2">09:00 </span></div></div>"`;

exports[`MessageList DOM output (golden) > translated overlay 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><div class="bubble"><span class="txt">नमस्ते</span><span class="meta2">09:00 </span></div></div><div class="row out" data-mi="1"><div class="bubble"><span class="txt">ठीक है</span><span class="meta2">09:00 <span class="tick">✓✓</span></span></div></div>"`;

exports[`MessageList DOM output (golden) > two-party text, grouped run 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><div class="bubble"><span class="txt">Kal milte hai?</span><span class="meta2">09:00 </span></div></div><div class="row out" data-mi="1"><div class="bubble"><span class="txt">Haan pakka</span><span class="meta2">09:00 <span class="tick">✓✓</span></span></div></div><div class="row out grp" data-mi="2"><div class="bubble"><span class="txt">Pakka pakka</span><span class="meta2">09:00 <span class="tick gray">✓✓</span></span></div></div>"`;

exports[`MessageList DOM output (golden) > typing indicator 1`] = `"<div class="day">1 June 2026</div><div class="row in" data-mi="0"><div class="bubble"><span class="txt">hi</span><span class="meta2">09:00 </span></div></div><div class="row in"><div class="bubble typing-bubble"><span class="td"></span><span class="td"></span><span class="td"></span></div></div>"`;
